    "express": "~4.16.1",
    "http-errors": "~1.6.3",
    "joi": "^18.1.2",
    "lodash": "^4.18.1",
    "md5": "^2.3.0",
    "morgan": "~1.9.1",
    "nodemon": "^3.1.14",
    "uuid": "^14.0.0"
